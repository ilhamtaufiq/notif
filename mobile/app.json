{
  "name": "NotifListener",
  "displayName": "NotifListener",
  "expo": {
    "name": "Notif Listener",
    "slug": "notif-listener",
    "version": "1.0.0",
    "orientation": "portrait",
    "android": {
      "package": "com.notiflistener",
      "allowBackup": false
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/with-sound-assets",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "39b4eddc-4516-4410-95b4-123230d91f38"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/39b4eddc-4516-4410-95b4-123230d91f38"
    }
  }
}
